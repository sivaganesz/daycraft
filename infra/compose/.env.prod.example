# Production stack settings for compose.prod.yml.
# Copy to `.env.prod` (git-ignored) and fill in real values. NEVER commit the real file.
# On the server it lives next to the compose file, readable only by the `deploy` user (SECURITY.md §2.5).
#
# The values below are for testing the stack LOCALLY. Production values are shown in comments.

# Hostnames Caddy serves (production: daycraft-api.whitraworks.online / whitraworks.online)
API_HOST=api.localhost
APEX_HOST=localhost
# Where the bare domain redirects to (production: https://daycraft.whitraworks.online)
APP_URL=http://localhost:5173

# The web app's origin: the only origin CORS allows (production: https://daycraft.whitraworks.online)
WEB_ORIGIN=http://localhost:5173

# Database password. Use letters and digits only (it's placed inside a URL).
# Generate one with:  openssl rand -hex 32
POSTGRES_PASSWORD=change-me-local-only

# Images to run (the deploy pipeline sets these to ghcr.io/... tags pinned to a commit SHA)
API_IMAGE=daycraft-api:local
MIGRATE_IMAGE=daycraft-api-migrate:local

LOG_LEVEL=info
