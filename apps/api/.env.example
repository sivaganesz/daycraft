# Copy to `.env` for local development (`.env` is git-ignored; never commit real secrets).
# Every variable is validated at startup by src/config/env.ts.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Local PostgreSQL from infra/compose/compose.dev.yml (local-only credentials)
DATABASE_URL=postgresql://daycraft:daycraft@localhost:5432/daycraft

# The web app's origin: the only origin CORS allows
WEB_ORIGIN=http://localhost:5173
