# Normalize line endings: store LF in the repository, regardless of OS.
# Important on Windows, where editors may write CRLF.
* text=auto eol=lf

# Windows scripts need CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files: never touch line endings or try to diff them
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary
*.gz binary
