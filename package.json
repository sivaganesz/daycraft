{
  "name": "daycraft",
  "version": "0.0.0",
  "private": true,
  "description": "DayCraft by Whitraworks: plan your day, track deadlines, focus, and work as a team.",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.22.0 <23",
    "pnpm": ">=12.9.1"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./packages/*\" --filter \"./apps/*\" dev",
    "build": "pnpm --recursive build",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm build && pnpm lint && pnpm typecheck && pnpm test",
    "db:up": "docker compose -f infra/compose/compose.dev.yml up -d --wait",
    "db:down": "docker compose -f infra/compose/compose.dev.yml down",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
